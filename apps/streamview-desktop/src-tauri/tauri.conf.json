{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamView",
  "version": "0.1.0",
  "identifier": "com.zhangyp.streamview-desktop",
  "build": {
    "frontendDist": "../../streamview-web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StreamView",
        "width": 1400,
        "height": 900,
        "url": "http://localhost:8799"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamView",
  "version": "0.1.0",
  "identifier": "com.zhangyp.streamview-desktop",
  "build": {
    "frontendDist": "../../streamview-web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "H.264/H.265 bitstream analyzer",
    "longDescription": "StreamView Lite analyzes H.264 and H.265 video bitstreams with a timeline, frame details, syntax tree, thumbnails, and motion vectors.",
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
